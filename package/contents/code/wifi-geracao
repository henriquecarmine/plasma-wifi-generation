#!/usr/bin/bash
# Wi-Fi generation and real negotiated speed, read from the kernel.
#
# Why this exists: NetworkManager does not expose the Wi-Fi generation in any
# field (checked 2026-08-15: the AP field list runs from NAME to DBUS-PATH and
# has no generation). Plasma's network applet reads everything from
# NetworkManager, so it has nowhere to take that from. The kernel knows, via
# nl80211 — which is what `iw` queries.
#
# The prefix of the negotiated bitrate gives the generation away:
#   EHT = Wi-Fi 7 (802.11be) · HE = Wi-Fi 6/6E (802.11ax)
#   VHT = Wi-Fi 5 (802.11ac) · MCS = Wi-Fi 4 (802.11n)
# No prefix at all means 802.11a/b/g, before Wi-Fi 4.
#
# OUTPUT CONTRACT — this script emits STABLE TOKENS, never prose.
# Words shown to the user are translated in QML, where gettext can reach
# them. A shell script cannot be put through a message catalogue, so any
# human-readable string produced here would be permanently untranslatable.
set -uo pipefail

# Saved Wi-Fi profiles, one per line, as "ssid<TAB>profile_name".
#
# The PROFILE name is not the SSID. Comparing an SSID against a profile name
# makes a saved network look new, and the click then tries to bring up a
# profile that does not exist.
_wifi_profiles() {
	/usr/bin/nmcli -t -f NAME,TYPE connection show 2>/dev/null \
	| awk -F: '$NF ~ /wireless/ { NF--; print }' OFS=: \
	| while IFS= read -r name; do
		[ -n "$name" ] || continue
		s=$(/usr/bin/nmcli -g 802-11-wireless.ssid connection show "$name" 2>/dev/null)
		[ -n "$s" ] && printf '%s\t%s\n' "$s" "$name"
	done
}

# --connect <ssid>: bring up an ALREADY SAVED connection, and say what happened.
#
# Lives here, not in a command line assembled in QML, for two reasons: the
# nmcli path stays absolute (Plasma's "executable" engine does not guarantee
# PATH), and the error is CAPTURED instead of discarded. The first version
# called nmcli straight from the widget without looking at output or exit
# code — it failed silently, which is the costliest kind of defect.
#
# Emits "OK|<detail>" or "FAIL|<detail>". The detail comes from nmcli, which
# is itself localised by the system, so it is passed through untouched.
# --connect <ssid> [bssid]
#
# Com BSSID, o perfil é AMARRADO àquele rádio antes de subir. É o que resolve
# o caso do repetidor: numa casa com dois rádios anunciando o mesmo nome, o
# NetworkManager escolhe pelo sinal, e nem sempre é onde você quer entrar —
# para configurar o principal, por exemplo. Sem BSSID, a amarra é DESFEITA,
# senão o perfil ficaria preso a um rádio que pode nem existir amanhã.
if [ "${1:-}" = "--connect" ]; then
	target="${2:-}"
	fixar="${3:-}"
	[ -n "$target" ] || { echo "FAIL|noname"; exit 1; }
	profile=$(_wifi_profiles | awk -F'\t' -v a="$target" '$1==a {print $2; exit}')
	alvo_perfil="${profile:-$target}"
	if [ -n "$fixar" ]; then
		/usr/bin/nmcli connection modify "$alvo_perfil" 802-11-wireless.bssid "$fixar" >/dev/null 2>&1
	else
		/usr/bin/nmcli connection modify "$alvo_perfil" 802-11-wireless.bssid "" >/dev/null 2>&1
	fi
	out=$(/usr/bin/nmcli con up id "$alvo_perfil" 2>&1); rc=$?
	# On-disk trail: without it, "I clicked and nothing happened" cannot be
	# diagnosed from outside — no way to tell whether the click arrived, the
	# command ran, or what nmcli answered.
	{
		echo "--- $(date '+%F %T') ---"
		echo "requested: $target"
		echo "profile  : ${profile:-(none, used the ssid itself)}"
		echo "rc       : $rc"
		echo "nmcli    : $out"
	} >> "${XDG_CACHE_HOME:-$HOME/.cache}/wifi-generation.log" 2>/dev/null
	if [ $rc -eq 0 ]; then
		echo "OK|$target"
	else
		reason=$(printf '%s' "$out" | tail -1 | sed 's/^Error: //')
		echo "FAIL|${reason:-exit $rc}"
	fi
	exit 0
fi

# --desfixar <ssid>: solta o perfil do rádio a que ele estava amarrado.
#
# Separado do --connect de propósito: desfixar NÃO reconecta. Quem tira a
# amarra costuma estar de saída do lugar — reconectar ali seria desfazer o
# que a pessoa acabou de pedir.
if [ "${1:-}" = "--desfixar" ]; then
	alvo="${2:-}"
	[ -n "$alvo" ] || { echo "FAIL|noname"; exit 1; }
	perfil=$(_wifi_profiles | awk -F'\t' -v a="$alvo" '$1==a {print $2; exit}')
	[ -n "$perfil" ] || { echo "FAIL|noprofile"; exit 1; }
	if /usr/bin/nmcli connection modify "$perfil" 802-11-wireless.bssid "" >/dev/null 2>&1; then
		echo "OK|$alvo"
	else
		echo "FAIL|$alvo"
	fi
	exit 0
fi

# Pontos de acesso vistos, UM POR LINHA, do cache de varredura do kernel:
#   "bssid<TAB>dbm<TAB>geracao<TAB>freq<TAB>ssid"
#
# Por PONTO DE ACESSO, não por nome de rede. É o que permite ver as
# concorrentes — dois rádios anunciando o mesmo SSID, caso de qualquer casa
# com repetidor — e amarrar a conexão a um deles.
#
# `iw scan dump` lê o cache e roda sem root; `iw scan` dispararia varredura e
# exigiria privilégio. O NetworkManager não expõe geração nenhuma e o
# wpa_supplicant nega o barramento a usuário comum.
_pontos() {
	[ -n "${IF:-}" ] || return 0
	cache="${XDG_CACHE_HOME:-$HOME/.cache}/wifi-geracao-pontos.tsv"

	# O registro fecha no PRÓXIMO "BSS": no `iw`, "last seen" e "signal" vêm
	# ANTES do SSID e das capacidades, e fechar numa linha interna gravava
	# registro vazio.
	visto=$(iw dev "$IF" scan dump 2>/dev/null | awk '
		function fecha() {
			if (bssid != "" && ssid != "")
				printf "%s\t%s\t%d\t%s\t%s\n", bssid, dbm, g, freq, ssid
		}
		/^BSS /            { fecha(); bssid=substr($2,1,17); ssid=""; g=0; dbm=""; freq="" }
		/^\tfreq: /        { freq=$2 }
		/^\tsignal: /      { dbm=$2 }
		/^\tSSID: /        { ssid=substr($0, 8) }
		/EHT capabilities/ { if (g<7) g=7 }
		/HE capabilities/  { if (g<6) g=6 }
		/VHT capabilities/ { if (g<5) g=5 }
		/HT capabilities/  { if (g<4) g=4 }
		END { fecha() }
	')

	# O cache do KERNEL guarda só a última varredura; o NetworkManager lembra
	# de redes ouvidas minutos atrás. Sem memória própria, a geração piscava
	# para a mesma rede — pior que não mostrar. A chave é o BSSID.
	#
	# Ler ANTES e gravar DEPOIS, sem `tee` no meio do cano: com o `tee`, o
	# arquivo era truncado enquanto a substituição ainda tentava lê-lo, e cada
	# chamada perdia parte do que já sabia — a lista encolhia sozinha entre
	# duas varreduras seguidas.
	antigo=$(cat "$cache" 2>/dev/null)
	fundido=$(printf '%s\n%s\n' "$visto" "$antigo" \
	| awk -F'\t' 'NF>=5 && $1!="" {
		if (!($1 in ordem)) ordem[$1]=++n
		if (!($1 in dbm) || $2 != "") dbm[$1]=$2
		if ($3+0 > g[$1]+0) g[$1]=$3
		if (freq[$1]=="") freq[$1]=$4
		if (ssid[$1]=="") ssid[$1]=$5
	} END {
		for (b in ordem) printf "%s\t%s\t%s\t%s\t%s\n", b, dbm[b], g[b], freq[b], ssid[b]
	}')
	printf '%s\n' "$fundido" > "$cache" 2>/dev/null
	printf '%s\n' "$fundido"
}



# A interface precisa ser conhecida ANTES da varredura: a geração de cada
# rede sai de `iw dev <if> scan dump`, e com IF vazio o campo saía em branco.
IF=$(iw dev 2>/dev/null | awk '/[[:space:]]Interface /{print $2; exit}')
# --networks [--scan] [--todos]: uma linha por rede, ou por PONTO DE ACESSO.
#
#   "emuso|pct|dbm|seguranca|salva|geracao|fixado|bssid|ssid"
#
# Sem --todos, sobra o ponto mais forte de cada nome — que é o que se quer
# ver no dia a dia. Com --todos, todos aparecem: é assim que se enxerga o
# repetidor ao lado do principal e se escolhe a qual entrar.
#
# O SSID continua por ÚLTIMO: é o único campo que pode conter "|" ou ":".
if [ "${1:-}" = "--networks" ]; then
	if [ "${2:-}" = "--scan" ] || [ "${3:-}" = "--scan" ]; then
		/usr/bin/nmcli dev wifi rescan >/dev/null 2>&1
		sleep 4   # rescan returns at once; the results arrive later
	fi
	todos=0
	case "${2:-}${3:-}" in *--todos*) todos=1 ;; esac

	# Uma leitura só, DEPOIS da varredura: calculada antes, uma rede que só
	# aparecia no scan novo saía sem geração.
	PONTOS=$(_pontos)
	saved=$(_wifi_profiles | cut -f1)
	# Segurança e "em uso" vêm do NetworkManager, por NOME de rede.
	segs=$(/usr/bin/nmcli -t -f SSID,SECURITY,IN-USE dev wifi list --rescan no 2>/dev/null)
	# BSSID em uso agora. O `nmcli -t` ESCAPA os dois-pontos do MAC como
	# "\:", e o `iw` devolve em minúsculas — comparar sem normalizar os dois
	# nunca casava, e nenhuma rede aparecia como conectada.
	atual=$(/usr/bin/nmcli -t -f ACTIVE,BSSID dev wifi list --rescan no 2>/dev/null \
	        | awk -F'^(sim|yes|não|no):' '/^(sim|yes):/ {print substr($0, index($0,":")+1); exit}' \
	        | tr -d '\\' | tr 'A-Z' 'a-z')

	# Perfis AMARRADOS a um rádio: "ssid<TAB>bssid". É o que a caixa "só
	# neste ponto" reflete — sem ler isto, ela mostraria desmarcada mesmo com
	# a amarra posta, e o dono desconfiaria da própria configuração.
	fixados=$(_wifi_profiles | while IFS=$'\t' read -r s_ssid s_perf; do
		b=$(/usr/bin/nmcli -g 802-11-wireless.bssid connection show "$s_perf" 2>/dev/null)
		[ -n "$b" ] && printf '%s\t%s\n' "$s_ssid" "$(printf '%s' "$b" | tr 'A-Z' 'a-z')"
	done)

	printf '%s\n' "$PONTOS" | while IFS=$'\t' read -r bssid dbm ger freq ssid; do
		[ -n "$ssid" ] || continue
		# dBm para porcento, a mesma régua que o NetworkManager usa:
		# −100 é 0%, −50 é 100%, linear no meio.
		d=${dbm%%.*}
		pct=$(( (d + 100) * 2 ))
		[ "$pct" -gt 100 ] && pct=100
		[ "$pct" -lt 0 ] && pct=0
		# Segurança desconhecida NÃO é rede aberta. Nossa lista tem memória
		# própria e o NetworkManager não: um ponto que ele já esqueceu vinha
		# com o campo vazio, e chamar isso de "aberta" desenhava cadeado
		# aberto numa rede protegida — mentira na tela, do lado errado.
		sec=$(printf '%s\n' "$segs" | awk -F: -v s="$ssid" '$1==s {print $2; exit}')
		if [ -z "$sec" ]; then
			printf '%s\n' "$segs" | awk -F: -v s="$ssid" '$1==s {found=1} END {exit !found}' \
				&& sec="open" || sec="unknown"
		fi
		if printf '%s\n' "$saved" | grep -qxF "$ssid"; then sav=1; else sav=0; fi
		uso=0
		[ -n "$atual" ] && [ "$(printf '%s' "$bssid" | tr 'A-Z' 'a-z')" = "$atual" ] && uso=1
		fix=0
		alvo=$(printf '%s\n' "$fixados" | awk -F'\t' -v s="$ssid" '$1==s {print $2; exit}')
		[ -n "$alvo" ] && [ "$(printf '%s' "$bssid" | tr 'A-Z' 'a-z')" = "$alvo" ] && fix=1
		printf '%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
			"$uso" "$pct" "${d:-}" "$sec" "$sav" "${ger:-}" "$fix" "$bssid" "$ssid"
	done \
	| sort -t'|' -k2,2nr \
	| if [ "$todos" = 1 ]; then
		# Mostrando cada aparelho, a ordem é ALFABÉTICA — e, dentro do mesmo
		# nome, do mais forte para o mais fraco. Por potência pura, o
		# repetidor e o principal ficam separados por vizinhos no meio da
		# lista, e a comparação que a pessoa foi fazer ali exige os dois
		# lado a lado.
		#
		# A primeira chave vai do campo 9 ao FIM da linha: o SSID é o último
		# campo justamente porque pode conter "|", e recortá-lo em nove
		# quebraria o nome de quem usa esse caractere.
		sort -t'|' -k9f -k2,2nr
	else
		# Uma linha por nome: sobra a mais forte, que é a que se quer ver no
		# dia a dia. A lista já vem ordenada por potência.
		awk -F'|' '!visto[$9]++'
	fi
	exit 0
fi

[ -n "${IF:-}" ] || { echo "nowifi"; exit 0; }

LINK=$(iw dev "$IF" link 2>/dev/null)

# --radio [on|off]: liga, desliga ou informa o rádio. Emite "on" ou "off".
#
# Fica ANTES de qualquer coisa que dependa da interface: com o rádio
# desligado não há `iw dev` nenhum, e o botão precisa continuar respondendo
# justamente nesse estado — senão desliga e não liga mais.
if [ "${1:-}" = "--radio" ]; then
	case "${2:-}" in
	on|off) /usr/bin/nmcli radio wifi "$2" >/dev/null 2>&1 ;;
	esac
	estado=$(/usr/bin/nmcli radio wifi 2>/dev/null)
	[ "$estado" = "enabled" ] && echo "on" || echo "off"
	exit 0
fi

# --rede: uma linha por interface física COM endereço:
#   "tipo|dev|ip/cidr|gateway|link_mbps"
#
# Duas linhas quando há cabo e wifi ao mesmo tempo, que é o caso de quem
# pluga o cabo sem desligar o rádio. Cada interface tem o SEU endereço, o SEU
# gateway e a SUA velocidade; mostrar só uma esconde metade da rede — e a
# primeira versão mostrava só a sem fio, o que apareceu no dia em que um cabo
# foi plugado na máquina.
#
# `link` é a velocidade negociada do meio em Mb/s (100, 1000, 2500…), lida do
# kernel. Só faz sentido no cabo: no wifi ela já vai no cabeçalho, vinda do
# `iw`, e muda a cada quadro.
_ip4() { /usr/sbin/ip -4 addr show "$1" 2>/dev/null | awk '/inet /{print $2; exit}'; }
_gw4() { /usr/sbin/ip -4 route show default dev "$1" 2>/dev/null | awk '{print $3; exit}'; }

# Só interface FÍSICA: sem o teste de `device` entram docker0, veth, br- e
# afins, que têm endereço e não são "a rede" de ninguém.
_interfaces() {
	for caminho in /sys/class/net/*; do
		dev=$(basename "$caminho")
		[ "$dev" = "lo" ] && continue
		[ -e "$caminho/device" ] || continue
		# Entra com endereço OU com PORTADORA. Exigir endereço escondia o
		# cabo recém-plugado, que fica minutos em "obtendo configuração de
		# IP" — e é exatamente nesse momento que o dono abre o balão para
		# ver se o cabo pegou. `carrier` dá erro em interface derrubada,
		# daí o `|| echo 0`.
		if [ -n "$(_ip4 "$dev")" ] \
		|| [ "$(cat "$caminho/carrier" 2>/dev/null || echo 0)" = "1" ]; then
			printf '%s\n' "$dev"
		fi
	done
}

if [ "${1:-}" = "--rede" ]; then
	_interfaces | while IFS= read -r dev; do
		if [ -d "/sys/class/net/$dev/wireless" ]; then
			printf 'wifi|%s|%s|%s|\n' "$dev" "$(_ip4 "$dev")" "$(_gw4 "$dev")"
		else
			vel=$(cat "/sys/class/net/$dev/speed" 2>/dev/null)
			[ "${vel:-0}" -gt 0 ] 2>/dev/null || vel=""
			printf 'cabo|%s|%s|%s|%s\n' \
				"$dev" "$(_ip4 "$dev")" "$(_gw4 "$dev")" "$vel"
		fi
	done
	exit 0
fi

# Perfil do NetworkManager que governa uma interface.
#
# Três degraus, porque o caso que importa é justamente o pior: com o cabo
# DESCONECTADO não há conexão ativa, e é exatamente aí que se quer entrar para
# corrigir o endereço. Buscar só em `device status` devolvia vazio e a tela de
# configuração não abria.
_perfil_de() {
	dev="$1"
	p=$(/usr/bin/nmcli -t -f DEVICE,CONNECTION device status 2>/dev/null \
	    | awk -F: -v d="$dev" '$1==d && $2!="--" {print $2; exit}')
	[ -n "$p" ] || p=$(/usr/bin/nmcli -t -f NAME,DEVICE connection show 2>/dev/null \
	    | awk -F: -v d="$dev" '$2==d {print $1; exit}')
	if [ -z "$p" ]; then
		tipo=802-3-ethernet
		[ -d "/sys/class/net/$dev/wireless" ] && tipo=802-11-wireless
		p=$(/usr/bin/nmcli -t -f NAME,TYPE connection show 2>/dev/null \
		    | awk -F: -v t="$tipo" '$2==t {print $1; exit}')
	fi
	printf '%s' "$p"
}

# --perfil <dev>: "perfil|metodo|ip/cidr|gateway|dns|pppoe"
#
# `metodo` é token do NetworkManager: auto (DHCP), manual, disabled…
# `pppoe` traz o NOME de um perfil PPPoE já existente para essa interface, ou
# vazio. O widget só OFERECE PPPoE se houver perfil — criar um exigiria pedir
# usuário e senha numa tela de painel e passá-los por linha de comando, onde
# qualquer processo os leria em `ps`. Trocar para um perfil que o dono já
# criou não tem esse problema.
if [ "${1:-}" = "--perfil" ]; then
	dev="${2:-}"
	[ -n "$dev" ] || { echo "|||||"; exit 0; }
	perfil=$(_perfil_de "$dev")
	metodo=""; ip4=""; gw=""; dns=""
	if [ -n "$perfil" ]; then
		metodo=$(/usr/bin/nmcli -g ipv4.method connection show "$perfil" 2>/dev/null)
		ip4=$(/usr/bin/nmcli -g ipv4.addresses connection show "$perfil" 2>/dev/null)
		gw=$(/usr/bin/nmcli -g ipv4.gateway connection show "$perfil" 2>/dev/null)
		dns=$(/usr/bin/nmcli -g ipv4.dns connection show "$perfil" 2>/dev/null)
	fi
	pppoe=$(/usr/bin/nmcli -t -f NAME,TYPE connection show 2>/dev/null \
	        | awk -F: '$2=="pppoe" {print $1; exit}')
	printf '%s|%s|%s|%s|%s|%s\n' \
		"$perfil" "${metodo:-}" "${ip4:-}" "${gw:-}" "${dns:-}" "${pppoe:-}"
	exit 0
fi

# --saida <dev>: o IP público visto pela INTERNET, saindo por essa interface.
#
# Consulta externa, por isso só roda sob demanda — quando o painel de
# endereços é aberto. Amarrada à interface com `--interface`, para dizer a
# verdade quando houver duas saídas: com cabo e wifi ligados em provedores
# diferentes, o IP público é diferente em cada uma.
#
# Serviço mínimo, que devolve só o endereço em texto puro. Emite o IP ou
# vazio — sem internet, vazio é a resposta honesta.
if [ "${1:-}" = "--saida" ]; then
	dev="${2:-}"; [ -n "$dev" ] || { echo ""; exit 0; }
	ip=$(curl -s --max-time 4 --interface "$dev" https://api.ipify.org 2>/dev/null)
	case "$ip" in
	*[!0-9.]*|"") echo "" ;;
	*)            echo "$ip" ;;
	esac
	exit 0
fi

# --enderecos <dev>: o retrato de endereçamento da interface.
#   "metodo|auto"            — como o perfil pega endereço
#   "fixo|192.168.1.50/24"   — cada endereço ESTÁTICO do perfil
#   "ativo|192.168.1.124/24" — cada endereço realmente montado agora
#
# Fixo e ativo são coisas diferentes e ambas importam: um endereço estático
# recém-adicionado só vira ativo depois que a conexão sobe, e um endereço de
# DHCP é ativo sem ser fixo. Mostrar só um dos dois mente em metade dos casos.
if [ "${1:-}" = "--enderecos" ]; then
	dev="${2:-}"; [ -n "$dev" ] || exit 0
	perfil=$(_perfil_de "$dev")
	if [ -n "$perfil" ]; then
		printf 'metodo|%s\n' "$(/usr/bin/nmcli -g ipv4.method connection show "$perfil" 2>/dev/null)"
		/usr/bin/nmcli -g ipv4.addresses connection show "$perfil" 2>/dev/null \
		| tr ',' '\n' | while IFS= read -r a; do
			a=$(printf '%s' "$a" | tr -d ' ')
			[ -n "$a" ] && printf 'fixo|%s\n' "$a"
		done
	fi
	/usr/sbin/ip -4 -o addr show "$dev" 2>/dev/null \
	| awk '{print "ativo|"$4}'
	exit 0
fi

# --addip <dev> <ip/cidr> · --delip <dev> <ip/cidr>
#
# Usa o `+`/`-` do nmcli, que existem justamente para propriedades de LISTA.
# Reescrever a lista inteira a cada mudança perderia o que já estava lá na
# primeira corrida de dedos.
#
# Não mexe no método: o NetworkManager aceita endereço estático JUNTO com
# `auto`. É isso que permite pendurar um IP de manutenção sem abrir mão do
# DHCP — e foi o que faltou no dia em que um roteador de fábrica precisou ser
# alcançado sem derrubar a rede de casa.
if [ "${1:-}" = "--addip" ] || [ "${1:-}" = "--delip" ]; then
	dev="${2:-}"; end="${3:-}"
	perfil=$(_perfil_de "$dev")
	[ -n "$perfil" ] || { echo "FAIL|noprofile"; exit 1; }
	[ -n "$end" ]    || { echo "FAIL|noaddress"; exit 1; }
	case "$end" in */*) : ;; *) end="$end/24" ;; esac
	if [ "$1" = "--addip" ]; then
		out=$(/usr/bin/nmcli connection modify "$perfil" +ipv4.addresses "$end" 2>&1); rc=$?
	else
		out=$(/usr/bin/nmcli connection modify "$perfil" -ipv4.addresses "$end" 2>&1); rc=$?
	fi
	[ "$rc" = 0 ] || { echo "FAIL|$out"; exit 1; }
	out=$(/usr/bin/nmcli connection up "$perfil" 2>&1); rc=$?
	[ "$rc" = 0 ] && echo "OK|$out" || echo "FAIL|$out"
	exit 0
fi

# --sugerir <dev> [rede]: um endereço LIVRE para manutenção, verificado.
#
# A escolha não é arbitrária. Varre de .240 para baixo, faixa que quase nunca
# está no poço do DHCP doméstico (que costuma ir de .100 a .200), e só devolve
# quem NÃO responder a ping — endereço em uso derruba a máquina do outro e
# nem sempre volta atrás sozinho.
#
# Emite "livre|<ip/cidr>" ou "nenhum|".
if [ "${1:-}" = "--sugerir" ]; then
	dev="${2:-}"; rede="${3:-}"
	if [ -z "$rede" ]; then
		rede=$(/usr/sbin/ip -4 -o addr show "$dev" 2>/dev/null \
		       | awk '{print $4; exit}')
	fi
	[ -n "$rede" ] || { echo "nenhum|"; exit 0; }
	base=$(printf '%s' "$rede" | cut -d/ -f1 | cut -d. -f1-3)
	mask=$(printf '%s' "$rede" | cut -d/ -f2)
	[ -n "$mask" ] || mask=24
	for ultimo in 240 241 242 245 250 230 220 210; do
		alvo="$base.$ultimo"
		if ! ping -c1 -W1 -n "$alvo" >/dev/null 2>&1; then
			printf 'livre|%s/%s\n' "$alvo" "$mask"
			exit 0
		fi
	done
	echo "nenhum|"
	exit 0
fi

# --aplicar <dev> auto
# --aplicar <dev> manual <ip/cidr> [gateway] [dns]
# --aplicar <dev> pppoe <perfil>
#
# Emite "OK|<detalhe>" ou "FAIL|<detalhe>", como o --connect: o resultado vai
# para a TELA. Aplicar endereço e não dizer o que houve é o defeito mais caro
# que este widget já teve.
if [ "${1:-}" = "--aplicar" ]; then
	dev="${2:-}"; modo="${3:-}"
	perfil=$(_perfil_de "$dev")
	[ -n "$perfil" ] || { echo "FAIL|noprofile"; exit 1; }
	case "$modo" in
	auto)
		out=$(/usr/bin/nmcli connection modify "$perfil" \
			ipv4.method auto ipv4.addresses "" ipv4.gateway "" ipv4.dns "" 2>&1); rc=$? ;;
	manual)
		end="${4:-}"; gw="${5:-}"; dns="${6:-}"
		[ -n "$end" ] || { echo "FAIL|noaddress"; exit 1; }
		out=$(/usr/bin/nmcli connection modify "$perfil" \
			ipv4.method manual ipv4.addresses "$end" \
			ipv4.gateway "$gw" ipv4.dns "$dns" 2>&1); rc=$? ;;
	pppoe)
		alvo="${4:-}"
		[ -n "$alvo" ] || { echo "FAIL|noprofile"; exit 1; }
		out=$(/usr/bin/nmcli connection up id "$alvo" 2>&1); rc=$?
		[ "$rc" = 0 ] && { echo "OK|$out"; exit 0; } || { echo "FAIL|$out"; exit 1; } ;;
	*) echo "FAIL|badmode"; exit 1 ;;
	esac
	if [ "$rc" != 0 ]; then echo "FAIL|$out"; exit 1; fi
	out=$(/usr/bin/nmcli connection up "$perfil" 2>&1); rc=$?
	[ "$rc" = 0 ] && echo "OK|$out" || echo "FAIL|$out"
	exit 0
fi

# --taxa: "dev|rx_bytes|tx_bytes", uma linha por interface.
#
# CONTADORES CRUS, não velocidade: a taxa sai da diferença entre duas
# leituras, e quem tem relógio é o QML. Fazer o script dormir um segundo para
# calcular aqui travaria o motor de execução do Plasma a cada atualização.
if [ "${1:-}" = "--taxa" ]; then
	_interfaces | while IFS= read -r dev; do
		printf '%s|%s|%s\n' "$dev" \
			"$(cat "/sys/class/net/$dev/statistics/rx_bytes" 2>/dev/null || echo 0)" \
			"$(cat "/sys/class/net/$dev/statistics/tx_bytes" 2>/dev/null || echo 0)"
	done
	exit 0
fi

case "$LINK" in
	*"Not connected"*|"") echo "disconnected"; exit 0 ;;
esac

rx=$(printf '%s\n' "$LINK" | awk '/rx bitrate:/{print; exit}')
tx=$(printf '%s\n' "$LINK" | awk '/tx bitrate:/{print; exit}')
sig=$(printf '%s\n' "$LINK" | awk '/signal:/{print $2; exit}')
frq=$(printf '%s\n' "$LINK" | awk '/freq:/{print $2; exit}')

# `num` is what goes INSIDE the icon, `gen` is the display name. Both come out
# ready: letting the widget dig the digit out of the text with a regular
# expression would render "802" for "802.11 a/b/g".
gen="unknown"
num=""
case "$rx$tx" in
	*EHT-MCS*) gen="Wi-Fi 7"; num="7" ;;
	*HE-MCS*)  gen="Wi-Fi 6"; num="6" ;;
	*VHT-MCS*) gen="Wi-Fi 5"; num="5" ;;
	*MCS*)     gen="Wi-Fi 4"; num="4" ;;
	# No MCS at all means 802.11a/b/g. The Wi-Fi Alliance only started naming
	# at 4, so there is no honest number to show — the icon keeps just the
	# arcs, which beats inventing a "3".
	*)         gen="802.11 a/b/g"; num="" ;;
esac

# 6 GHz is what separates Wi-Fi 6 from 6E. The band starts at 5925 MHz.
band=""
if [ -n "${frq:-}" ]; then
	case "$frq" in *.*) f=${frq%%.*} ;; *) f=$frq ;; esac
	if   [ "${f:-0}" -ge 5925 ] 2>/dev/null; then band="6"
	elif [ "${f:-0}" -ge 4900 ] 2>/dev/null; then band="5"
	else                                          band="2.4"
	fi
	if [ "$gen" = "Wi-Fi 6" ] && [ "$band" = "6" ]; then
		gen="Wi-Fi 6E"
		num="6E"
	fi
fi

vrx=$(printf '%s\n' "$rx" | awk '{for(i=1;i<=NF;i++) if($i=="bitrate:"){printf "%d", $(i+1); exit}}')
vtx=$(printf '%s\n' "$tx" | awk '{for(i=1;i<=NF;i++) if($i=="bitrate:"){printf "%d", $(i+1); exit}}')

# --detail: "gen|ssid|rx|tx|signal|quality|channel|width|number|band"
if [ "${1:-}" = "--detail" ]; then
	ssid=$(printf '%s\n' "$LINK" | awk '/SSID:/{ $1=""; sub(/^ /,""); print; exit}')
	info=$(iw dev "$IF" info 2>/dev/null)
	chan=$(printf '%s\n' "$info" | awk '/channel /{for(i=1;i<=NF;i++) if($i=="channel"){print $(i+1); exit}}')
	# `iw info` prints "width: 80 MHz," — the comma comes glued on and would
	# leak to the screen if not stripped here.
	width=$(printf '%s\n' "$info" | awk '/width:/{for(i=1;i<=NF;i++) if($i=="width:"){w=$(i+1)" "$(i+2); gsub(/,$/,"",w); print w; exit}}')
	# Quality as a TOKEN. dBm alone says nothing to someone outside the
	# trade, but the words belong in the catalogue, not here.
	q="unknown"
	if [ -n "${sig:-}" ]; then
		s=${sig%%.*}
		if   [ "$s" -ge -50 ] 2>/dev/null; then q="excellent"
		elif [ "$s" -ge -60 ] 2>/dev/null; then q="good"
		elif [ "$s" -ge -67 ] 2>/dev/null; then q="fair"
		elif [ "$s" -ge -73 ] 2>/dev/null; then q="weak"
		else                                    q="veryweak"
		fi
	fi
	printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
		"$gen" "${ssid:-}" "${vrx:-}" "${vtx:-}" "${sig:-}" "$q" \
		"${chan:-}" "${width:-}" "$num" "$band"
	exit 0
fi

# Default mode is for humans at a terminal, in English, and is not part of
# the widget's contract.
out="$gen"
[ -n "${vrx:-}" ] && [ -n "${vtx:-}" ] && out="$out · ${vrx}/${vtx} Mb/s"
[ -n "${sig:-}" ] && out="$out · ${sig} dBm"
echo "$out"
